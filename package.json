{
  "name": "methane-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/**\" --filter \"!@methane/react\" --filter \"!@methane/vue\" --filter \"!@methane/angular\" --filter \"!@methane/svelte\" --filter \"./tooling/**\" --if-present run build && pnpm run codegen && pnpm --filter @methane/react --filter @methane/vue --filter @methane/angular --filter @methane/svelte --filter \"./apps/**\" --if-present run build",
    "codegen": "node tooling/wrapper-codegen/dist/cli.js --workspace && node tooling/figma-sync/dist/cli.js",
    "codegen:check": "node tooling/wrapper-codegen/dist/cli.js --workspace --check",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "@methane/core": "*"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
