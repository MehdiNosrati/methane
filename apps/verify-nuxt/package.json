{
  "name": "@methane/verify-nuxt",
  "version": "0.1.0",
  "private": true,
  "description": "Nuxt 3 SSR & Vue 3 wrapper verification app for Methane UI",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "NUXT_TELEMETRY_DISABLED=1 nuxt dev",
    "build": "NUXT_TELEMETRY_DISABLED=1 nuxt prepare && NUXT_TELEMETRY_DISABLED=1 nuxt build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --testTimeout=20000"
  },
  "dependencies": {
    "@methane/core": "workspace:*",
    "@methane/css": "workspace:*",
    "@methane/primitives": "workspace:*",
    "@methane/ssr": "workspace:*",
    "@methane/ssr-nuxt": "workspace:*",
    "@methane/tokens": "workspace:*",
    "@methane/ui": "workspace:*",
    "@methane/vue": "workspace:*",
    "nuxt": "^3.16.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@methane/test-conformance": "workspace:*"
  }
}
