{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false,
    "packageManager": "pnpm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "verify-angular": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/verify-angular",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "ssr": true,
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "aot": false,
            "optimization": false,
            "styles": [
              "@methane/tokens/tokens.css",
              "@methane/css/index.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "aot": false,
              "optimization": false,
              "outputHashing": "all"
            },
            "development": {
              "aot": false,
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
