{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist/node-server"
  },
  "include": [
    "src/server.ts",
    "src/http-server.ts",
    "src/main.server.ts",
    "src/app/**/*.ts"
  ],
  "exclude": ["src/**/*.test.ts", "node_modules", "dist", ".angular"]
}
