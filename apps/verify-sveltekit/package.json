{
  "name": "@methane-ui/verify-sveltekit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SvelteKit 2 + Svelte 5 bind:* SSR verification app for Methane UI",
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "typecheck": "svelte-kit sync && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --testTimeout=20000"
  },
  "dependencies": {
    "@methane-ui/core": "workspace:^",
    "@methane-ui/css": "workspace:^",
    "@methane-ui/primitives": "workspace:^",
    "@methane-ui/ssr-sveltekit": "workspace:^",
    "@methane-ui/svelte": "workspace:^",
    "@methane-ui/tokens": "workspace:^",
    "@methane-ui/ui": "workspace:^",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@methane-ui/test-conformance": "workspace:^",
    "@sveltejs/adapter-node": "^5.0.0",
    "@sveltejs/kit": "^2.50.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.1.0"
  }
}
