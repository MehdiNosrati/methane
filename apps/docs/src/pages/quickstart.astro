---
import CodeTabs from '../components/CodeTabs.astro';
import DocsLayout from '../components/DocsLayout.astro';
import { withBase } from '../lib/links.js';

const installSnippets = {
  html: `pnpm add @methane-ui/tokens @methane-ui/css @methane-ui/ui`,
  react: `pnpm add @methane-ui/tokens @methane-ui/css @methane-ui/ui @methane-ui/react`,
  vue: `pnpm add @methane-ui/tokens @methane-ui/css @methane-ui/ui @methane-ui/vue`,
  angular: `pnpm add @methane-ui/tokens @methane-ui/css @methane-ui/ui @methane-ui/angular`,
  svelte: `pnpm add @methane-ui/tokens @methane-ui/css @methane-ui/ui @methane-ui/svelte`,
};

const usageSnippets = {
  html: `<link rel="stylesheet" href="@methane-ui/tokens/tokens.css" />
<link rel="stylesheet" href="@methane-ui/css/index.css" />
<script type="module" src="@methane-ui/ui/button"></script>

<mth-stack data-gap="4">
  <mth-button variant="solid">Save changes</mth-button>
</mth-stack>`,
  react: `import '@methane-ui/tokens/tokens.css';
import '@methane-ui/css/index.css';
import '@methane-ui/ui/button';
import '@methane-ui/react';

export function SaveAction() {
  return (
    <mth-stack data-gap="4">
      <mth-button variant="solid" onmth-press={() => console.log('saved')}>
        Save changes
      </mth-button>
    </mth-stack>
  );
}`,
  vue: `<script setup lang="ts">
import '@methane-ui/tokens/tokens.css';
import '@methane-ui/css/index.css';
import '@methane-ui/ui/button';
import '@methane-ui/vue';
</script>

<template>
  <mth-stack data-gap="4">
    <mth-button variant="solid" @mth-press="() => console.log('saved')">
      Save changes
    </mth-button>
  </mth-stack>
</template>`,
  angular: `import { Component, CUSTOM_ELEMENTS_SCHEMA } from '@angular/core';
import '@methane-ui/ui/button';
import { MthButtonDirective } from '@methane-ui/angular';

@Component({
  standalone: true,
  schemas: [CUSTOM_ELEMENTS_SCHEMA],
  imports: [MthButtonDirective],
  template: \`
    <mth-stack data-gap="4">
      <mth-button variant="solid" (mthPress)="onSave()">Save changes</mth-button>
    </mth-stack>
  \`,
})
export class SaveActionComponent {
  onSave() {}
}`,
  svelte: `<script lang="ts">
  import '@methane-ui/tokens/tokens.css';
  import '@methane-ui/css/index.css';
  import '@methane-ui/ui/button';
  import MthButton from '@methane-ui/svelte/MthButton.svelte';
</script>

<mth-stack data-gap="4">
  <MthButton variant="solid">Save changes</MthButton>
</mth-stack>`,
};
---

<DocsLayout title="Quickstart">
  <mth-stack data-gap="6">
    <div class="mth-prose">
      <h1>Quickstart</h1>
      <p>
        Load <code>@methane-ui/tokens</code> and <code>@methane-ui/css</code> once at your application root,
        then import only the <code>@methane-ui/ui/*</code> entrypoints and typed framework wrappers you need.
      </p>
    </div>

    <section class="mth-stack" data-gap="3">
      <h2>1. Install Packages</h2>
      <CodeTabs id="quickstart-install" snippets={installSnippets} />
    </section>

    <section class="mth-stack" data-gap="3">
      <h2>2. Render Layouts &amp; Components</h2>
      <CodeTabs id="quickstart-usage" snippets={usageSnippets} />
    </section>

    <div class="docs-callout">
      <strong>Tip:</strong> For React 18 apps lacking React 19 native custom-element support, import
      wrappers from <code>@methane-ui/react/legacy</code> instead of <code>@methane-ui/react</code>.
    </div>

    <mth-flex data-gap="3">
      <a class="docs-btn" href={withBase('/guides/ssr')}>Next: Server Rendering →</a>
      <a class="docs-btn" href={withBase('/css')}>Explore CSS Layouts</a>
      <a class="docs-btn" href={withBase('/guides/skills')}>Agent Skills</a>
    </mth-flex>
  </mth-stack>
</DocsLayout>
