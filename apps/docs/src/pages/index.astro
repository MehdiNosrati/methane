---
import DocsLayout from '../components/DocsLayout.astro';
import { loadComponentDocs } from '../lib/component-loader.js';
import { CSS_PRIMITIVE_CATALOG } from '../lib/css-catalog.js';
import { withBase } from '../lib/links.js';

const components = await loadComponentDocs();
const totalDeliverables = components.length + CSS_PRIMITIVE_CATALOG.length;
const packageCount = new Set(components.map((c) => c.packageName)).size;
---

<DocsLayout title="Introduction">
  <mth-stack data-gap="8">
    <section class="docs-hero-grid" aria-label="Methane Design System introduction">
      <div class="mth-hero" style="padding-block:var(--mth-space-4);padding-inline:0;text-align:start">
        <div class="mth-hero-content" style="margin-inline:0;align-items:flex-start">
          <span class="mth-hero-eyebrow">Methane Design System · @methane/*</span>
          <h1 class="mth-hero-title">Spec-first Web Components &amp; 0 B JS CSS Primitives</h1>
          <p class="mth-hero-lead">
            {totalDeliverables} UI deliverables ({components.length} custom elements across {packageCount}{' '}
            component packages plus {CSS_PRIMITIVE_CATALOG.length} zero-JS Light-DOM CSS primitives)
            with Precision Atmospheric OKLCH tokens, streaming DSD SSR across 6 frameworks, and
            typed framework wrappers.
          </p>
          <div class="mth-hero-actions" style="justify-content:flex-start">
            <a class="docs-btn docs-btn-primary" href={withBase('/quickstart')}>Get Started</a>
            <a class="docs-btn" href={withBase('/components')}>
              Browse {components.length} Components
            </a>
            <a class="docs-btn" href={withBase('/css')}>23 CSS Primitives</a>
            <a class="docs-btn" href={withBase('/theme-builder')}>Theme Builder</a>
          </div>
        </div>
      </div>

      <aside class="docs-hero-studio" aria-label="Interactive Component Studio">
        <div class="docs-hero-studio-head">
          <mth-flex data-gap="2" data-align="center">
            <strong>Component Studio</strong>
            <mth-badge variant="accent" pill>Live Elements</mth-badge>
          </mth-flex>
          <span class="docs-badge" data-hero-status>Interactive · click or toggle</span>
        </div>

        <div class="docs-hero-studio-row" aria-label="Live button variants">
          <mth-button variant="solid" size="sm" data-hero-action="solid">Solid</mth-button>
          <mth-button variant="soft" size="sm" data-hero-action="soft">Soft</mth-button>
          <mth-button variant="outline" size="sm" data-hero-action="outline">Outline</mth-button>
          <mth-button variant="ghost" size="sm" data-hero-action="ghost">Ghost</mth-button>
          <mth-button variant="danger" size="sm" data-hero-action="danger">Danger</mth-button>
        </div>

        <div class="mth-grid" style="--mth-grid-min:11rem">
          <mth-input
            label="Project slug"
            placeholder="methane-studio"
            value="methane-ui"
            data-hero-input
          ></mth-input>
          <mth-select
            label="Adapter target"
            placeholder="Select adapter..."
            value="astro"
            data-hero-select
          >
            <mth-option value="astro" label="Astro SSR (DSD)">Astro SSR (DSD)</mth-option>
            <mth-option value="next" label="Next.js 15 RSC">Next.js 15 RSC</mth-option>
            <mth-option value="nuxt" label="Nuxt 3 Nitro">Nuxt 3 Nitro</mth-option>
            <mth-option value="sveltekit" label="SvelteKit 2">SvelteKit 2</mth-option>
          </mth-select>
        </div>

        <div class="docs-hero-studio-row" style="justify-content:space-between">
          <mth-flex data-gap="4" data-align="center">
            <mth-switch checked data-hero-switch>OKLCH Dark Mode</mth-switch>
            <mth-checkbox checked data-hero-checkbox>Strict Spec</mth-checkbox>
          </mth-flex>
          <mth-badge variant="success" dot>WCAG AA</mth-badge>
        </div>
      </aside>
    </section>

    <section class="mth-feature-grid">
      <article class="mth-feature-card">
        <span class="mth-feature-icon">0B</span>
        <h2>Earned Shadow DOM</h2>
        <p>
          Structural, typographic, and static marketing blocks ship in <code>@methane/css</code> as
          23 pure Light-DOM CSS primitives using CSS Logical Properties and <code>@layer mth.primitives</code>.
        </p>
      </article>
      <article class="mth-feature-card">
        <span class="mth-feature-icon">OKLCH</span>
        <h2>Adaptive Token Engine</h2>
        <p>
          W3C DTCG JSON compiled via <code>@methane/tokens</code> into <code>light-dark()</code>,
          <code>oklch()</code> relative ramps, density multipliers, and <code>forced-colors: active</code>.
        </p>
      </article>
      <article class="mth-feature-card">
        <span class="mth-feature-icon">DSD</span>
        <h2>Hybrid Streaming SSR</h2>
        <p>
          <code>@methane/ssr</code> + Next, Nuxt, SvelteKit, Astro, and Angular adapters emit cached
          stylesheet links with &lt;1 KB critical inline shells and zero hydration replacement.
        </p>
      </article>
    </section>

    <section class="mth-bento-grid">
      <div class="mth-bento-item" data-span="2">
        <h3>Strictly Acyclic Package DAG</h3>
        <p>
          <code>tokens / sanitize → core → primitives → ui → kits → satellites</code>.
          Components compose shared controllers from <code>@methane/primitives</code> and never import
          sibling internals.
        </p>
        <mth-flex data-gap="2">
          <a class="docs-btn" href={withBase('/architecture')}>Architecture Overview</a>
          <a class="docs-btn" href={withBase('/adrs')}>Read ADRs 001–015</a>
        </mth-flex>
      </div>
      <div class="mth-bento-item">
        <h3>Interactive Theme Studio</h3>
        <p>Tune OKLCH brand seeds, radius scale, and density, then export CSS or DTCG JSON.</p>
        <a class="docs-btn docs-btn-primary" href={withBase('/theme-builder')}>Open Theme Builder</a>
      </div>
    </section>

    <section class="mth-cta" data-variant="accent">
      <div>
        <h2>Ready to wire Methane into your stack?</h2>
        <p>Follow the multi-framework quickstart for HTML, React 19, Vue, Angular, or Svelte 5.</p>
      </div>
      <div class="mth-cta-actions">
        <a class="docs-btn" href={withBase('/quickstart')}>Quickstart Guide →</a>
      </div>
    </section>
  </mth-stack>

  <script>
    const statusEl = document.querySelector<HTMLElement>('[data-hero-status]');
    const setStatus = (msg: string) => {
      if (statusEl) statusEl.textContent = msg;
    };

    for (const btn of document.querySelectorAll<HTMLElement>('[data-hero-action]')) {
      btn.addEventListener('mth-press', () => {
        setStatus(`Pressed variant="${btn.dataset.heroAction ?? ''}"`);
      });
    }

    document.querySelector('[data-hero-input]')?.addEventListener('mth-input', (ev) => {
      const val = (ev as CustomEvent<{ value?: string }>).detail?.value ?? '';
      setStatus(`mth-input: "${val}"`);
    });

    document.querySelector('[data-hero-select]')?.addEventListener('mth-change', (ev) => {
      const val = (ev as CustomEvent<{ value?: string }>).detail?.value ?? '';
      setStatus(`mth-select: "${val}"`);
    });

    document.querySelector('[data-hero-switch]')?.addEventListener('mth-change', (ev) => {
      const checked = Boolean((ev as CustomEvent<{ checked?: boolean }>).detail?.checked);
      setStatus(`mth-switch: ${checked ? 'on' : 'off'}`);
    });

    document.querySelector('[data-hero-checkbox]')?.addEventListener('mth-change', (ev) => {
      const checked = Boolean((ev as CustomEvent<{ checked?: boolean }>).detail?.checked);
      setStatus(`mth-checkbox: ${checked ? 'checked' : 'unchecked'}`);
    });
  </script>
</DocsLayout>
