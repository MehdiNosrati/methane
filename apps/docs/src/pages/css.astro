---
import CodeTabs from '../components/CodeTabs.astro';
import DocsLayout from '../components/DocsLayout.astro';
import { CSS_PRIMITIVE_CATALOG } from '../lib/css-catalog.js';

const categories = ['Layout', 'Typography & Surface', 'Content & Marketing'] as const;
---

<DocsLayout title="23 CSS Primitives">
  <mth-stack data-gap="6">
    <div class="mth-prose">
      <h1>23 Light-DOM CSS Primitives (<code>@methane/css</code>)</h1>
      <p>
        <strong>Rule #1 — Earned Shadow DOM:</strong> Structural, typographic, and static marketing
        blocks ship as 0 B JS Light-DOM CSS primitives in <code>@layer mth.primitives</code>,
        using CSS Logical Properties only and adapting automatically to light, dark, density, and
        <code>forced-colors: active</code>.
      </p>
    </div>

    <mth-flex data-gap="2">
      {
        CSS_PRIMITIVE_CATALOG.map((item) => (
          <a class="docs-badge" href={`#${item.id}`} style="text-decoration:none">
            .{item.id}
          </a>
        ))
      }
    </mth-flex>

    {
      categories.map((category) => {
        const items = CSS_PRIMITIVE_CATALOG.filter((entry) => entry.category === category);
        return (
          <section class="mth-stack" data-gap="5">
            <h2>
              {category} ({items.length})
            </h2>
            {items.map((item) => (
              <article class="docs-card" id={item.id}>
                <mth-stack data-gap="4">
                  <mth-flex data-justify="between" data-gap="2">
                    <mth-flex data-gap="2">
                      <h3 style="margin-block:0">{item.title}</h3>
                      <code>{item.selector}</code>
                    </mth-flex>
                    <mth-flex data-gap="2">
                      <span class="docs-badge">0 B JS</span>
                      <span class="docs-badge">{item.subpath}</span>
                    </mth-flex>
                  </mth-flex>

                  <p style="margin-block:0;color:var(--mth-color-fg-muted)">{item.description}</p>

                  <div class="docs-callout">
                    <strong>When NOT to use:</strong> {item.whenNotToUse}
                  </div>

                  <div class="docs-preview" set:html={item.previewHtml} />

                  <CodeTabs id={`css-${item.id}`} snippets={item.snippets} />
                </mth-stack>
              </article>
            ))}
          </section>
        );
      })
    }
  </mth-stack>
</DocsLayout>
