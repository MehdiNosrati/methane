---
import CodeTabs from '../../components/CodeTabs.astro';
import DocsLayout from '../../components/DocsLayout.astro';

const ssrSnippets = {
  html: `import { renderToString, transformHtmlDsd } from '@methane/ssr';

const result = await transformHtmlDsd('<mth-button variant="solid">Save</mth-button>', {
  styles: 'linked',
  assetBase: '/assets/methane',
});`,
  react: `import { renderNextDsd, withMethaneNextHeaders } from '@methane/ssr-next';
// Next.js App Router RSC + React 19 native custom-element streaming`,
  vue: `import { createMethaneNuxtNitroPlugin } from '@methane/ssr-nuxt';
// Nuxt Nitro server plugin expanding DSD + hoisting stylesheet links`,
  angular: `import { provideMethaneSsr } from '@methane/ssr-angular';
// Non-destructive Angular SSR serialization + hydration`,
  svelte: `import { createMethaneSvelteKitHandle } from '@methane/ssr-sveltekit';
// SvelteKit handle hook for streaming DSD + asset hoisting`,
};
---

<DocsLayout title="Server Rendering & Hydration">
  <mth-stack data-gap="6">
    <div class="mth-prose">
      <h1>Server-Side Rendering &amp; Hydration</h1>
      <p>
        Methane wraps <code>@lit-labs/ssr</code> behind <code>@methane/ssr</code> and ships
        adapters for Next.js, Nuxt, SvelteKit, Astro, and Angular so custom elements render on the
        server with Declarative Shadow DOM and hydrate cleanly on the client.
      </p>

      <h2>Hybrid Stylesheet Delivery</h2>
      <ul>
        <li>
          <strong><code>styles: 'linked'</code> (Default):</strong> Emits a content-hashed
          <code>&lt;link rel="stylesheet" href="..."&gt;</code> inside
          <code>&lt;template shadowrootmode="open"&gt;</code> paired with a compact critical inline
          <code>&lt;style&gt;</code> shell to prevent FOUC and layout shift.
        </li>
        <li>
          <strong><code>styles: 'inline'</code>:</strong> Embeds the full component stylesheet inside
          <code>&lt;style&gt;</code> for emails, single-file HTML exports, and edge responses.
        </li>
        <li>
          <strong>Client-only fallback:</strong> <code>@methane/css/defined-guard.css</code> applies a
          fail-open <code>:not(:defined)</code> reveal animation (never <code>visibility: hidden</code>),
          while pure-CSS layout tags (<code>mth-stack</code>, <code>mth-grid</code>, <code>mth-flex</code>,
          <code>mth-container</code>, <code>mth-spacer</code>) stay immediately visible at <code>opacity: 1</code>.
        </li>
      </ul>
    </div>

    <CodeTabs id="ssr-adapters" snippets={ssrSnippets} />
  </mth-stack>
</DocsLayout>
