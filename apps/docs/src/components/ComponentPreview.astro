---
import type { ComponentDocEntry } from '../lib/component-loader.js';
import { ALL_DEMO_SPECS } from '../lib/demos/index.js';
import { renderDemoHtml } from '../lib/demos/render-html.js';
import type { DemoNode, DemoSpec } from '../lib/demos/types.js';

interface Props {
  entry: ComponentDocEntry;
}

const { entry } = Astro.props;
const stageId = `preview-${entry.tagName}`;
const demoSpec: DemoSpec = ALL_DEMO_SPECS[entry.tagName] ?? {};
const demoHtml = renderDemoHtml(entry.tagName, demoSpec);
const modelEvents = entry.model.events.map((ev) => ev.name);

interface PropControl {
  name: string;
  attr: string;
  kind: 'boolean' | 'enum' | 'text';
  options?: string[];
  defaultValue: string;
}

const PROP_PRIORITY: Readonly<Record<string, number>> = {
  variant: 1,
  size: 2,
  type: 3,
  disabled: 4,
  loading: 5,
  checked: 6,
  indeterminate: 7,
  pressed: 8,
  multiple: 9,
  clearable: 10,
  pill: 11,
  dot: 12,
  removable: 13,
  interactive: 14,
  striped: 15,
  closable: 16,
  open: 17,
  orientation: 18,
  activation: 19,
  label: 20,
  placeholder: 21,
  value: 22,
};

function findTreeTargetAttrs(
  nodes: DemoNode | ReadonlyArray<DemoNode>,
  preferredTag: string,
  matchByTag: boolean,
): Readonly<Record<string, string | number | boolean>> | undefined {
  const list = Array.isArray(nodes) ? nodes : [nodes];
  for (const node of list) {
    if (
      !matchByTag &&
      node.attrs &&
      Object.prototype.hasOwnProperty.call(node.attrs, 'data-preview-target') &&
      node.attrs['data-preview-target'] !== false
    ) {
      return node.attrs;
    }
    if (matchByTag && node.tag === preferredTag) {
      return node.attrs;
    }
    if (node.children) {
      const childNodes = node.children.filter((c): c is DemoNode => typeof c !== 'string');
      if (childNodes.length > 0) {
        const found = findTreeTargetAttrs(childNodes, preferredTag, matchByTag);
        if (found) return found;
      }
    }
  }
  return undefined;
}

function resolveTargetAttrs(
  spec: DemoSpec,
  tagName: string,
): Readonly<Record<string, string | number | boolean>> {
  const treeAttrs = spec.tree
    ? (findTreeTargetAttrs(spec.tree, tagName, false) ??
      findTreeTargetAttrs(spec.tree, tagName, true))
    : undefined;
  return {
    ...(treeAttrs ?? {}),
    ...(spec.attrs ?? {}),
  };
}

function looksLikeJsonLiteral(value: string): boolean {
  const trimmed = value.trim();
  return (
    (trimmed.startsWith('{') && trimmed.endsWith('}')) ||
    (trimmed.startsWith('[') && trimmed.endsWith(']'))
  );
}

function buildControls(
  targetAttrs: Readonly<Record<string, string | number | boolean>>,
): PropControl[] {
  const sortedProps = [...entry.model.props].sort((a, b) => {
    const pa = PROP_PRIORITY[a.name] ?? 100;
    const pb = PROP_PRIORITY[b.name] ?? 100;
    return pa - pb;
  });

  const controls: PropControl[] = [];
  for (const prop of sortedProps) {
    if (controls.length >= 6) break;
    if (prop.attr === null) continue;
    const attr = prop.attr ?? prop.name;
    const rawType = prop.type.trim();
    const cleanDefault = (prop.defaultValue ?? '').replace(/^['"]|['"]$/g, '');
    const demoAttrVal = targetAttrs[attr] ?? targetAttrs[prop.name];

    if (rawType === 'boolean' || rawType === 'boolean | undefined') {
      const initialBool =
        demoAttrVal !== undefined
          ? demoAttrVal === true || demoAttrVal === '' || demoAttrVal === 'true'
          : cleanDefault === 'true';
      controls.push({
        name: prop.name,
        attr,
        kind: 'boolean',
        defaultValue: initialBool ? 'true' : 'false',
      });
    } else if (rawType.includes('|') && rawType.includes("'")) {
      const options = rawType
        .split('|')
        .map((part) => part.trim())
        .filter((part) => /^['"][^'"]*['"]$/.test(part))
        .map((part) => part.slice(1, -1));
      if (options.length > 0) {
        const demoStr =
          typeof demoAttrVal === 'string' || typeof demoAttrVal === 'number'
            ? String(demoAttrVal)
            : '';
        const initialValue = options.includes(demoStr)
          ? demoStr
          : options.includes(cleanDefault)
            ? cleanDefault
            : (options[0] ?? '');
        controls.push({
          name: prop.name,
          attr,
          kind: 'enum',
          options,
          defaultValue: initialValue,
        });
      }
    } else if (rawType === 'string' || rawType === 'string | undefined') {
      const initialStr =
        typeof demoAttrVal === 'string' || typeof demoAttrVal === 'number'
          ? String(demoAttrVal)
          : cleanDefault;
      if (
        looksLikeJsonLiteral(cleanDefault) ||
        looksLikeJsonLiteral(initialStr) ||
        cleanDefault.length > 40 ||
        initialStr.length > 40
      ) {
        continue;
      }
      controls.push({
        name: prop.name,
        attr,
        kind: 'text',
        defaultValue: initialStr,
      });
    }
  }
  return controls;
}

const targetAttrs = resolveTargetAttrs(demoSpec, entry.tagName);
const propControls = buildControls(targetAttrs);
---

<section
  class="docs-preview docs-preview-stage"
  id={stageId}
  data-preview-stage
  data-preview-tag={entry.tagName}
  data-preview-package={entry.packageName}
  data-preview-group={entry.packageGroup}
  data-preview-events={JSON.stringify(modelEvents)}
  data-preview-upcoming="false"
  aria-label={`Live interactive preview for ${entry.tagName}`}
>
  <div class="docs-preview-toolbar">
    <mth-flex data-gap="2" data-align="center">
      <strong>Interactive Stage</strong>
      <span class="docs-badge" data-preview-status>
        {`Live Custom Element · <${entry.tagName}> (${entry.packageName})`}
      </span>
    </mth-flex>

    <div class="docs-preview-controls">
      <label class="docs-preview-control">
        <span>Theme</span>
        <select class="mth-select docs-select" data-preview-theme aria-label="Preview stage theme">
          <option value="auto">Auto</option>
          <option value="light">Light</option>
          <option value="dark">Dark</option>
          <option value="high-contrast">High Contrast</option>
        </select>
      </label>

      <label class="docs-preview-control">
        <span>Direction</span>
        <select class="mth-select docs-select" data-preview-dir aria-label="Preview text direction">
          <option value="ltr">LTR</option>
          <option value="rtl">RTL</option>
        </select>
      </label>

      {
        propControls.map((ctrl) =>
          ctrl.kind === 'boolean' ? (
            <label class="docs-preview-control">
              <input
                type="checkbox"
                data-preview-prop={ctrl.attr}
                data-preview-prop-name={ctrl.name}
                checked={ctrl.defaultValue === 'true'}
              />
              <span>{ctrl.name}</span>
            </label>
          ) : ctrl.kind === 'enum' ? (
            <label class="docs-preview-control">
              <span>{ctrl.name}</span>
              <select
                class="mth-select docs-select"
                data-preview-prop={ctrl.attr}
                data-preview-prop-name={ctrl.name}
                aria-label={`Prop ${ctrl.name}`}
              >
                {(ctrl.options ?? []).map((opt) => (
                  <option value={opt} selected={opt === ctrl.defaultValue}>
                    {opt}
                  </option>
                ))}
              </select>
            </label>
          ) : (
            <label class="docs-preview-control">
              <span>{ctrl.name}</span>
              <input
                type="text"
                value={ctrl.defaultValue}
                placeholder={ctrl.name}
                data-preview-prop={ctrl.attr}
                data-preview-prop-name={ctrl.name}
              />
            </label>
          ),
        )
      }
    </div>
  </div>

  <div class="docs-preview-canvas" data-preview-canvas dir="ltr">
    <Fragment set:html={demoHtml} />
  </div>

  <div class="docs-preview-output" data-preview-readout>
    Ready · interact with &lt;{entry.tagName}&gt;, or toggle Theme, Direction (LTR/RTL), or props above.
  </div>
</section>

<script>
  import {
    loadDemoSpec,
    loadPreviewPackage,
    type PreviewPackageGroup,
  } from '../lib/demos/package-loader.js';

  const COMMON_MTH_EVENTS = [
    'mth-press',
    'mth-input',
    'mth-change',
    'mth-select',
    'mth-remove',
    'mth-open',
    'mth-after-open',
    'mth-close',
    'mth-clear',
    'mth-confirm',
    'mth-cancel',
    'mth-page-change',
    'mth-sort',
    'mth-filter',
    'mth-error-captured',
    'mth-reset',
  ];

  function formatEventDetail(detail: unknown): string {
    if (detail === undefined) return '';
    try {
      const json = JSON.stringify(detail);
      if (!json) return '';
      return json.length > 160 ? `: ${json.slice(0, 157)}...` : `: ${json}`;
    } catch {
      return ': [detail]';
    }
  }

  function parseEventsList(raw: string | undefined): string[] {
    if (!raw) return [];
    try {
      const parsed: unknown = JSON.parse(raw);
      return Array.isArray(parsed)
        ? parsed.filter((item): item is string => typeof item === 'string')
        : [];
    } catch {
      return [];
    }
  }

  const stages = document.querySelectorAll<HTMLElement>('[data-preview-stage]');

  for (const stage of stages) {
    const tag = stage.dataset.previewTag ?? '';
    const pkg = stage.dataset.previewPackage ?? '';
    const group = (stage.dataset.previewGroup ?? 'ui') as PreviewPackageGroup;
    const modelEvents = parseEventsList(stage.dataset.previewEvents);
    const canvas = stage.querySelector<HTMLElement>('[data-preview-canvas]');
    const readoutEl = stage.querySelector<HTMLElement>('[data-preview-readout]');
    const themeSelect = stage.querySelector<HTMLSelectElement>('[data-preview-theme]');
    const dirSelect = stage.querySelector<HTMLSelectElement>('[data-preview-dir]');
    const targetEl = stage.querySelector<HTMLElement>('[data-preview-target]');
    const propControls = stage.querySelectorAll<HTMLElement>('[data-preview-prop]');

    function setReadout(msg: string) {
      if (readoutEl) readoutEl.textContent = msg;
    }

    function syncControlValue(attr: string, value: string | boolean) {
      const escaped = typeof CSS !== 'undefined' && typeof CSS.escape === 'function'
        ? CSS.escape(attr)
        : attr;
      const ctrl = stage.querySelector<HTMLElement>(`[data-preview-prop="${escaped}"]`);
      if (!ctrl) return;
      if (ctrl instanceof HTMLInputElement && ctrl.type === 'checkbox') {
        ctrl.checked = Boolean(value);
      } else if (ctrl instanceof HTMLInputElement || ctrl instanceof HTMLSelectElement) {
        ctrl.value = String(value);
      }
    }

    function applyCanvasTheme(val: string) {
      if (!canvas) return;
      canvas.removeAttribute('data-mth-theme');
      canvas.removeAttribute('data-mth-contrast');
      if (val === 'light' || val === 'dark') {
        canvas.setAttribute('data-mth-theme', val);
      } else if (val === 'high-contrast') {
        canvas.setAttribute('data-mth-contrast', 'high');
      }
      setReadout(`Stage theme="${val}" · dir="${canvas.getAttribute('dir') ?? 'ltr'}"`);
    }

    themeSelect?.addEventListener('change', () => applyCanvasTheme(themeSelect.value));
    dirSelect?.addEventListener('change', () => {
      if (!canvas) return;
      canvas.setAttribute('dir', dirSelect.value);
      setReadout(`Stage dir="${dirSelect.value}" · CSS logical properties flipped automatically.`);
    });

    function applySinglePropControl(ctrl: HTMLElement, el: HTMLElement | null) {
      if (!el) return;
      const attr = ctrl.dataset.previewProp;
      const propName = ctrl.dataset.previewPropName;
      if (!attr) return;
      const record = el as unknown as Record<string, unknown>;

      if (ctrl instanceof HTMLInputElement && ctrl.type === 'checkbox') {
        if (ctrl.checked) {
          el.setAttribute(attr, '');
        } else {
          el.removeAttribute(attr);
        }
        if (propName) {
          record[propName] = ctrl.checked;
        }
        setReadout(`Updated ${attr}="${String(ctrl.checked)}" on <${tag}>.`);
      } else if (ctrl instanceof HTMLSelectElement || ctrl instanceof HTMLInputElement) {
        const val = ctrl.value;
        if (val === '') {
          el.removeAttribute(attr);
        } else {
          el.setAttribute(attr, val);
        }
        if (propName) {
          record[propName] = val;
        }
        setReadout(`Updated ${attr}=${JSON.stringify(val)} on <${tag}>.`);
      }
    }

    for (const ctrl of propControls) {
      const eventName =
        ctrl instanceof HTMLInputElement && ctrl.type === 'text' ? 'input' : 'change';
      ctrl.addEventListener(eventName, () => applySinglePropControl(ctrl, targetEl));
    }

    void (async () => {
      try {
        const [, demoSpec] = await Promise.all([
          loadPreviewPackage(pkg),
          loadDemoSpec(group, tag),
        ]);

        if (tag) {
          await customElements.whenDefined(tag);
        }

        if (targetEl) {
          if (demoSpec?.props) {
            const record = targetEl as unknown as Record<string, unknown>;
            for (const [key, value] of Object.entries(demoSpec.props)) {
              record[key] = value;
            }
          }

          const eventNames = new Set<string>([...modelEvents, ...COMMON_MTH_EVENTS]);
          for (const evName of eventNames) {
            targetEl.addEventListener(evName, (ev) => {
              const detail = (ev as CustomEvent<unknown>).detail;
              setReadout(`<${tag}> ${evName}${formatEventDetail(detail)}`);
            });
          }

          if (demoSpec?.setup && canvas) {
            await demoSpec.setup({
              stage,
              canvas,
              target: targetEl,
              setReadout,
              syncControlValue,
            });
          }
        }
      } catch (err) {
        const message = err instanceof Error ? err.message : String(err);
        setReadout(`Preview hydration error for <${tag}>: ${message}`);
      }
    })();
  }
</script>
