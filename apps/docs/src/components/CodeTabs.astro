---
interface Props {
  id: string;
  snippets: {
    readonly html: string;
    readonly react: string;
    readonly vue: string;
    readonly angular: string;
    readonly svelte: string;
  };
}

const { id, snippets } = Astro.props;
const frameworks = [
  { key: 'html', label: 'HTML', code: snippets.html },
  { key: 'react', label: 'React 19', code: snippets.react },
  { key: 'vue', label: 'Vue', code: snippets.vue },
  { key: 'angular', label: 'Angular', code: snippets.angular },
  { key: 'svelte', label: 'Svelte 5', code: snippets.svelte },
] as const;
---

<div class="docs-tabs" data-code-tabs={id}>
  <div class="docs-tablist" role="tablist" aria-label="Framework code examples">
    {
      frameworks.map((fw, index) => (
        <button
          type="button"
          class="docs-tab"
          role="tab"
          id={`${id}-tab-${fw.key}`}
          aria-controls={`${id}-panel-${fw.key}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
          data-tab-target={fw.key}
        >
          {fw.label}
        </button>
      ))
    }
    <mth-spacer></mth-spacer>
    <span class="docs-copy-wrap">
      <button
        type="button"
        class="docs-tab docs-copy-btn"
        data-copy-active={id}
        aria-label="Copy active code snippet"
      >
        Copy
      </button>
      <span class="docs-copy-status" role="status" data-copy-status></span>
    </span>
  </div>
  {
    frameworks.map((fw, index) => (
      <div
        class="docs-tabpanel"
        role="tabpanel"
        id={`${id}-panel-${fw.key}`}
        aria-labelledby={`${id}-tab-${fw.key}`}
        data-panel-key={fw.key}
        hidden={index !== 0}
      >
        <pre class="docs-code"><code>{fw.code}</code></pre>
      </div>
    ))
  }
</div>

<script>
  const copyTimers = new WeakMap<HTMLButtonElement, number>();
  let lastCopyAnnouncement = '';

  function legacyCopy(text: string): boolean {
    const field = Object.assign(document.createElement('textarea'), { value: text });
    field.setAttribute('readonly', '');
    field.style.cssText = 'position:fixed;inset-block-start:0;opacity:0';
    document.body.append(field);
    field.select();
    try {
      return document.execCommand('copy');
    } finally {
      field.remove();
    }
  }

  function reportCopyStatus(btn: HTMLButtonElement, statusEl: HTMLElement | null, ok: boolean) {
    const prevTimer = copyTimers.get(btn);
    if (prevTimer !== undefined) {
      window.clearTimeout(prevTimer);
    }
    btn.removeAttribute('data-copied');
    btn.removeAttribute('data-failed');

    let message = ok ? 'Copied' : 'Copy failed';
    btn.setAttribute(ok ? 'data-copied' : 'data-failed', '');
    btn.textContent = message;

    if (statusEl) {
      if (message === lastCopyAnnouncement) message += '\u00A0';
      lastCopyAnnouncement = message;
      statusEl.textContent = '';
      statusEl.classList.add('is-visible');
      requestAnimationFrame(() => {
        statusEl.textContent = message;
      });
    }

    const timer = window.setTimeout(() => {
      btn.removeAttribute('data-copied');
      btn.removeAttribute('data-failed');
      btn.textContent = 'Copy';
      if (statusEl) {
        statusEl.textContent = '';
        statusEl.classList.remove('is-visible');
      }
    }, 1600);
    copyTimers.set(btn, timer);
  }

  for (const container of document.querySelectorAll('[data-code-tabs]')) {
    const tabs = [...container.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...container.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const copyBtn = container.querySelector<HTMLButtonElement>('[data-copy-active]');
    const copyStatus = container.querySelector<HTMLElement>('[data-copy-status]');

    const activate = (nextTab: HTMLButtonElement) => {
      const targetKey = nextTab.dataset.tabTarget;
      for (const tab of tabs) {
        const selected = tab === nextTab;
        tab.setAttribute('aria-selected', selected ? 'true' : 'false');
        tab.tabIndex = selected ? 0 : -1;
      }
      for (const panel of panels) {
        panel.hidden = panel.dataset.panelKey !== targetKey;
      }
    };

    for (const tab of tabs) {
      tab.addEventListener('click', () => activate(tab));
      tab.addEventListener('keydown', (event) => {
        const idx = tabs.indexOf(tab);
        if (event.key === 'ArrowRight') {
          const next = tabs[(idx + 1) % tabs.length]!;
          activate(next);
          next.focus();
        } else if (event.key === 'ArrowLeft') {
          const prev = tabs[(idx - 1 + tabs.length) % tabs.length]!;
          activate(prev);
          prev.focus();
        }
      });
    }

    copyBtn?.addEventListener('click', async () => {
      const visiblePanel = panels.find((p) => !p.hidden);
      const text = visiblePanel?.textContent?.trim() ?? '';
      if (!text) return;
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(text);
          reportCopyStatus(copyBtn, copyStatus, true);
        } else if (legacyCopy(text)) {
          reportCopyStatus(copyBtn, copyStatus, true);
        } else {
          reportCopyStatus(copyBtn, copyStatus, false);
        }
      } catch {
        const fallbackOk = legacyCopy(text);
        reportCopyStatus(copyBtn, copyStatus, fallbackOk);
      }
    });
  }
</script>
