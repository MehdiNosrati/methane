{
  "name": "@methane-ui/verify-next",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js 15 App Router (RSC + React 19) SSR & DSD hydration verification app for Methane UI",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --testTimeout=20000"
  },
  "dependencies": {
    "@methane-ui/core": "workspace:^",
    "@methane-ui/css": "workspace:^",
    "@methane-ui/primitives": "workspace:^",
    "@methane-ui/react": "workspace:^",
    "@methane-ui/ssr": "workspace:^",
    "@methane-ui/ssr-next": "workspace:^",
    "@methane-ui/tokens": "workspace:^",
    "@methane-ui/ui": "workspace:^",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@methane-ui/test-conformance": "workspace:^",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
