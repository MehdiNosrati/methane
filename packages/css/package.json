{
  "name": "@methane-ui/css",
  "version": "0.1.0",
  "description": "Cascade layers, CSS logical-property reset, fail-open :not(:defined) guard, and 0 B JS Light-DOM CSS primitives for Methane UI",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/*.css"
  ],
  "dependencies": {
    "@methane-ui/tokens": "workspace:^"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "style": "./dist/index.css",
      "default": "./dist/index.js"
    },
    "./index.css": "./dist/index.css",
    "./base.css": "./dist/base.css",
    "./layers.css": "./dist/layers.css",
    "./reset.css": "./dist/reset.css",
    "./defined-guard.css": "./dist/defined-guard.css",
    "./layout.css": "./dist/layout.css",
    "./prose.css": "./dist/prose.css",
    "./marketing.css": "./dist/marketing.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node dist/build.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src && stylelint 'src/**/*.css' 'dist/**/*.css' --allow-empty-input",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MehdiNosrati/methane.git"
  },
  "homepage": "https://mahdins.dev/methane/"
}
