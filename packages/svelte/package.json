{
  "name": "@methane/svelte",
  "version": "0.1.0",
  "description": "Svelte 5 typed wrappers supporting bind:value, bind:checked, and bind:open for Methane UI (ADR-009)",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*.svelte": {
      "svelte": "./src/generated/svelte/*.svelte",
      "default": "./src/generated/svelte/*.svelte"
    },
    "./components/*.svelte": {
      "svelte": "./src/generated/svelte/*.svelte",
      "default": "./src/generated/svelte/*.svelte"
    }
  },
  "files": [
    "dist",
    "src/generated/svelte"
  ],
  "scripts": {
    "build": "node ../../tooling/wrapper-codegen/dist/cli.js --root ../.. --only svelte && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@methane/wrapper-codegen": "workspace:^",
    "svelte": "^5.57.3"
  }
}
