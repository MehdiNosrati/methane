{
  "name": "@methane/react",
  "version": "0.1.0",
  "description": "React 19+ zero-runtime JSX/event types and React 18 @lit/react legacy wrappers for Methane UI (ADR-009)",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./legacy": {
      "types": "./dist/legacy.d.ts",
      "default": "./dist/legacy.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../tooling/wrapper-codegen/dist/cli.js --root ../.. --only react && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@lit/react": "^1.0.8"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@methane/wrapper-codegen": "workspace:^",
    "@types/react": "^19.0.0",
    "react": "^19.0.0"
  }
}
