{
  "name": "@methane/ssr-nuxt",
  "version": "0.1.0",
  "description": "Nuxt Nitro server plugin and Vue SSR custom-element adapter for Methane UI (ADR-009)",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
