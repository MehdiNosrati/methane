{
  "name": "@methane/editor",
  "version": "0.1.0",
  "description": "Methane rich-text (ProseMirror), Markdown, and LaTeX math (KaTeX) editor satellite components",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/components/*/index.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./*/element.js": {
      "types": "./dist/components/*/element.d.ts",
      "default": "./dist/components/*/element.js"
    },
    "./*/element": {
      "types": "./dist/components/*/element.d.ts",
      "default": "./dist/components/*/element.js"
    },
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "default": "./dist/components/*/index.js"
    }
  },
  "customElements": "custom-elements.json",
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src scripts",
    "test": "vitest run"
  },
  "dependencies": {
    "@methane/core": "workspace:^",
    "@methane/primitives": "workspace:^",
    "@methane/sanitize": "workspace:^",
    "@methane/tokens": "workspace:^",
    "katex": "^0.16.11",
    "lit": "^3.2.1",
    "prosemirror-commands": "^1.6.0",
    "prosemirror-history": "^1.4.1",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-model": "^1.22.0",
    "prosemirror-schema-basic": "^1.2.2",
    "prosemirror-schema-list": "^1.4.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.34.0"
  },
  "devDependencies": {
    "@lit-labs/ssr": "^4.1.0",
    "@lit-labs/ssr-client": "^1.1.8",
    "@lit-labs/ssr-dom-shim": "^1.6.0",
    "@methane/spec-compiler": "workspace:^",
    "@methane/test-conformance": "workspace:^"
  },
  "peerDependencies": {
    "@methane/core": "^0.1.0 || ^1.0.0"
  }
}
