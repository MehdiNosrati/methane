          "name": "MthPdfViewer",
          "tagName": "mth-pdf-viewer",
          "customElement": true,
          "delegatesFocus": true,
          "description": "Wrap-first Mozilla pdf.js `<mth-pdf-viewer>` component supporting page navigation, zoom presets, text search, document outline, URL sanitization, keyboard/RTL navigation, and `<slot name=\"fallback\">`.",
          "superclass": {
            "name": "UIElement",
            "package": "@methane-ui/core"
          },
