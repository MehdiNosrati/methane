                "key": "PageDown",
                "when": "viewer viewport is focused",
                "expect": "advances to the next PDF page"
              },
              {
                "key": "PageUp",
                "when": "viewer viewport is focused",
                "expect": "returns to the previous PDF page"
              },
              {
                "key": "ArrowRight",
                "dir": "ltr",
                "when": "viewer viewport is focused",
                "expect": "advances to the next PDF page"
              },
              {
                "key": "ArrowLeft",
                "dir": "rtl",
                "when": "viewer viewport is focused",
                "expect": "advances to the next PDF page in RTL"
              },
              {
                "key": "Home",
                "when": "viewer viewport is focused",
                "expect": "jumps to page 1"
              },
              {
                "key": "End",
                "when": "viewer viewport is focused",
                "expect": "jumps to the last page"
