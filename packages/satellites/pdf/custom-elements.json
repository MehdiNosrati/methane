              "kind": "field",
              "name": "src",
              "attribute": "src",
              "reflect": true,
              "type": {
                "text": "string"
              },
              "default": "\"\"",
              "description": "URL to PDF document (validated with @methane-ui/sanitize isSafeUrl)."
            },
            {
              "kind": "field",
              "name": "workerSrc",
              "attribute": "worker-src",
              "type": {
                "text": "string"
              },
              "default": "\"\"",
              "description": "Optional custom pdf.js worker script URL. Strongly recommended in production to keep pdf.js parsing off the main thread and prevent bundling pdf.worker.mjs (~several hundred KB) into app lazy chunks."
            },
            {
              "kind": "field",
              "name": "documentTitle",
              "attribute": "document-title",
              "type": {
                "text": "string"
              },
              "default": "\"\"",
