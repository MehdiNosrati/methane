        {
          "kind": "class",
          "name": "MthFlowEditor",
          "tagName": "mth-flow-editor",
          "customElement": true,
          "delegatesFocus": true,
          "description": "Accessible node/DAG flow editor wrapping @dagrejs/dagre with pan/zoom plane and keyboard node traversal.",
          "superclass": {
            "name": "UIElement",
            "package": "@methane/core"
          },
          "members": [
            {
              "kind": "field",
              "name": "nodes",
