                "text": "ReadonlyArray<FlowNode>"
              },
              "description": "Flow node definitions."
            },
            {
              "kind": "field",
              "name": "edges",
              "type": {
                "text": "ReadonlyArray<FlowEdge>"
              },
              "description": "Directed edges connecting source and target node IDs."
            },
            {
              "kind": "field",
              "name": "direction",
              "attribute": "direction",
              "type": {
                "text": "'TB' | 'LR' | 'RL' | 'BT' | 'auto'"
              },
              "default": "\"auto\"",
              "description": "DAG layout rank direction (auto resolves LR/RL from document direction)."
            },
            {
              "kind": "field",
              "name": "edgeStyle",
              "attribute": "edge-style",
              "type": {
                "text": "'bezier' | 'orthogonal'"
              },
              "default": "\"bezier\"",
