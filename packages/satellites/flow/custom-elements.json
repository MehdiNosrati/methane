              {
                "name": "panY",
                "attr": "pan-y",
                "type": "number",
                "default": 0
              },
              {
                "name": "selectedId",
                "attr": "selected-id",
                "type": "string",
                "default": ""
              },
              {
                "name": "autoLayout",
                "attr": "auto-layout",
                "type": "boolean",
                "default": true
              },
              {
                "name": "label",
                "type": "string",
                "default": ""
