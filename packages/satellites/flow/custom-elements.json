            {
              "kind": "field",
              "name": "panY",
              "attribute": "pan-y",
              "type": {
                "text": "number"
              },
              "default": "0",
              "description": "Vertical pan offset in pixels."
            },
            {
              "kind": "field",
              "name": "selectedId",
              "attribute": "selected-id",
              "type": {
                "text": "string"
              },
              "default": "\"\"",
