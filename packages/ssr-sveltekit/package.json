{
  "name": "@methane-ui/ssr-sveltekit",
  "version": "0.1.2",
  "description": "SvelteKit server handle DSD transform and client hydration adapter for Methane UI (ADR-009)",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/client.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@methane-ui/ssr": "workspace:^",
    "lit": "^3.3.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MehdiNosrati/methane.git"
  },
  "homepage": "https://mahdins.dev/methane/"
}
