{
  "name": "@methane-ui/vue",
  "version": "0.1.1",
  "description": "Vue 3 Volar GlobalComponents, v-model wrappers, and compiler preset for Methane UI (ADR-009)",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../tooling/wrapper-codegen/dist/cli.js --root ../.. --only vue && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@methane-ui/wrapper-codegen": "workspace:^",
    "vue": "^3.5.45"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MehdiNosrati/methane.git"
  },
  "homepage": "https://mahdins.dev/methane/"
}
