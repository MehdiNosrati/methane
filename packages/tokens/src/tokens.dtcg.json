{
  "$description": "Methane UI W3C Design Tokens Community Group (DTCG) source tokens",
  "color": {
    "$type": "color",
    "seed": {
      "brand": {
        "$value": "oklch(0.56 0.21 255)",
        "$description": "Primary brand accent seed in OKLCH"
      },
      "neutral": {
        "$value": "oklch(0.55 0.015 255)",
        "$description": "Neutral slate seed in OKLCH"
      },
      "danger": {
        "$value": "oklch(0.57 0.22 25)",
        "$description": "Semantic danger/error seed in OKLCH"
      },
      "warning": {
        "$value": "oklch(0.75 0.17 75)",
        "$description": "Semantic warning seed in OKLCH"
      },
      "success": {
        "$value": "oklch(0.60 0.17 150)",
        "$description": "Semantic success seed in OKLCH"
      },
      "info": {
        "$value": "oklch(0.62 0.16 230)",
        "$description": "Semantic info seed in OKLCH"
      }
    },
    "brand": {
      "50": {
        "$value": "oklch(from var(--mth-color-seed-brand) 0.97 calc(c * 0.18) h)",
        "$description": "Brand ramp step 50"
      },
      "100": {
        "$value": "oklch(from var(--mth-color-seed-brand) 0.93 calc(c * 0.32) h)",
        "$description": "Brand ramp step 100"
      },
      "200": {
        "$value": "oklch(from var(--mth-color-seed-brand) 0.86 calc(c * 0.50) h)",
        "$description": "Brand ramp step 200"
      },
      "300": {
        "$value": "oklch(from var(--mth-color-seed-brand) 0.77 calc(c * 0.72) h)",
        "$description": "Brand ramp step 300"
      },
      "400": {
        "$value": "oklch(from var(--mth-color-seed-brand) 0.67 calc(c * 0.90) h)",
        "$description": "Brand ramp step 400"
      },
      "500": {
        "$value": "oklch(from var(--mth-color-seed-brand) l c h)",
        "$description": "Brand ramp step 500"
      },
      "600": {
        "$value": "oklch(from var(--mth-color-seed-brand) calc(l - 0.08) c h)",
        "$description": "Brand ramp step 600"
      },
      "700": {
        "$value": "oklch(from var(--mth-color-seed-brand) calc(l - 0.16) calc(c * 0.92) h)",
        "$description": "Brand ramp step 700"
      },
      "800": {
        "$value": "oklch(from var(--mth-color-seed-brand) calc(l - 0.24) calc(c * 0.80) h)",
        "$description": "Brand ramp step 800"
      },
      "900": {
        "$value": "oklch(from var(--mth-color-seed-brand) calc(l - 0.31) calc(c * 0.65) h)",
        "$description": "Brand ramp step 900"
      },
      "950": {
        "$value": "oklch(from var(--mth-color-seed-brand) 0.20 calc(c * 0.50) h)",
        "$description": "Brand ramp step 950"
      }
    },
    "neutral": {
      "50": {
        "$value": "oklch(from var(--mth-color-seed-neutral) 0.985 calc(c * 0.30) h)"
      },
      "100": {
        "$value": "oklch(from var(--mth-color-seed-neutral) 0.960 calc(c * 0.45) h)"
      },
      "200": {
        "$value": "oklch(from var(--mth-color-seed-neutral) 0.915 calc(c * 0.60) h)"
      },
      "300": {
        "$value": "oklch(from var(--mth-color-seed-neutral) 0.840 calc(c * 0.75) h)"
      },
      "400": {
        "$value": "oklch(from var(--mth-color-seed-neutral) 0.700 calc(c * 0.90) h)"
      },
      "500": {
        "$value": "oklch(from var(--mth-color-seed-neutral) l c h)"
      },
      "600": {
        "$value": "oklch(from var(--mth-color-seed-neutral) 0.450 c h)"
      },
      "700": {
        "$value": "oklch(from var(--mth-color-seed-neutral) 0.360 c h)"
      },
      "800": {
        "$value": "oklch(from var(--mth-color-seed-neutral) 0.270 calc(c * 0.90) h)"
      },
      "900": {
        "$value": "oklch(from var(--mth-color-seed-neutral) 0.200 calc(c * 0.80) h)"
      },
      "950": {
        "$value": "oklch(from var(--mth-color-seed-neutral) 0.145 calc(c * 0.70) h)"
      }
    },
    "bg": {
      "$value": "oklch(0.99 0.002 255)",
      "$extensions": {
        "com.methane.theme": {
          "light": "oklch(0.995 0.002 255)",
          "dark": "{color.neutral.950}"
        }
      },
      "$description": "Primary page background"
    },
    "bgSubtle": {
      "$value": "{color.neutral.100}",
      "$extensions": {
        "com.methane.theme": {
          "light": "{color.neutral.100}",
          "dark": "{color.neutral.900}"
        }
      },
      "$description": "Subtle recessed background"
    },
    "surface": {
      "$value": "oklch(1 0 0)",
      "$extensions": {
        "com.methane.theme": {
          "light": "oklch(1 0 0)",
          "dark": "{color.neutral.900}"
        }
      },
      "$description": "Component surface background"
    },
    "surfaceRaised": {
      "$value": "oklch(1 0 0)",
      "$extensions": {
        "com.methane.theme": {
          "light": "oklch(1 0 0)",
          "dark": "{color.neutral.800}"
        }
      },
      "$description": "Elevated overlay/card surface"
    },
    "fg": {
      "$value": "{color.neutral.950}",
      "$extensions": {
        "com.methane.theme": {
          "light": "{color.neutral.950}",
          "dark": "{color.neutral.50}"
        }
      },
      "$description": "Primary foreground text"
    },
    "fgMuted": {
      "$value": "{color.neutral.600}",
      "$extensions": {
        "com.methane.theme": {
          "light": "{color.neutral.600}",
          "dark": "{color.neutral.400}"
        }
      },
      "$description": "Secondary muted text"
    },
    "fgSubtle": {
      "$value": "{color.neutral.500}",
      "$extensions": {
        "com.methane.theme": {
          "light": "{color.neutral.500}",
          "dark": "{color.neutral.500}"
        }
      },
      "$description": "Placeholder and subtle text"
    },
    "border": {
      "$value": "{color.neutral.200}",
      "$extensions": {
        "com.methane.theme": {
          "light": "{color.neutral.200}",
          "dark": "{color.neutral.800}"
        }
      },
      "$description": "Default hairline border"
    },
    "borderStrong": {
      "$value": "{color.neutral.300}",
      "$extensions": {
        "com.methane.theme": {
          "light": "{color.neutral.300}",
          "dark": "{color.neutral.700}"
        }
      },
      "$description": "Interactive control border"
    },
    "borderFocus": {
      "$value": "{color.brand.500}",
      "$extensions": {
        "com.methane.theme": {
          "light": "{color.brand.500}",
          "dark": "{color.brand.400}"
        }
      },
      "$description": "Focus ring color"
    },
    "accent": {
      "$value": "{color.brand.500}",
      "$extensions": {
        "com.methane.theme": {
          "light": "{color.brand.500}",
          "dark": "{color.brand.400}"
        }
      },
      "$description": "Primary interactive accent"
    },
    "accentHover": {
      "$value": "{color.brand.600}",
      "$extensions": {
        "com.methane.theme": {
          "light": "{color.brand.600}",
          "dark": "{color.brand.300}"
        }
      }
    },
    "accentActive": {
      "$value": "{color.brand.700}",
      "$extensions": {
        "com.methane.theme": {
          "light": "{color.brand.700}",
          "dark": "{color.brand.200}"
        }
      }
    },
    "accentSubtle": {
      "$value": "{color.brand.50}",
      "$extensions": {
        "com.methane.theme": {
          "light": "{color.brand.50}",
          "dark": "{color.brand.950}"
        }
      }
    },
    "accentFg": {
      "$value": "oklch(0.99 0 0)",
      "$extensions": {
        "com.methane.theme": {
          "light": "oklch(0.99 0 0)",
          "dark": "{color.neutral.950}"
        }
      },
      "$description": "Text on accent surface"
    },
    "danger": {
      "$value": "{color.seed.danger}",
      "$extensions": {
        "com.methane.theme": {
          "light": "oklch(from var(--mth-color-seed-danger) l c h)",
          "dark": "oklch(from var(--mth-color-seed-danger) calc(l + 0.14) c h)"
        }
      }
    },
    "dangerSubtle": {
      "$value": "oklch(from var(--mth-color-seed-danger) 0.95 calc(c * 0.25) h)",
      "$extensions": {
        "com.methane.theme": {
          "light": "oklch(from var(--mth-color-seed-danger) 0.96 calc(c * 0.22) h)",
          "dark": "oklch(from var(--mth-color-seed-danger) 0.22 calc(c * 0.45) h)"
        }
      }
    },
    "warning": {
      "$value": "{color.seed.warning}",
      "$extensions": {
        "com.methane.theme": {
          "light": "oklch(from var(--mth-color-seed-warning) calc(l - 0.10) c h)",
          "dark": "oklch(from var(--mth-color-seed-warning) calc(l + 0.06) c h)"
        }
      }
    },
    "warningSubtle": {
      "$value": "oklch(from var(--mth-color-seed-warning) 0.95 calc(c * 0.25) h)",
      "$extensions": {
        "com.methane.theme": {
          "light": "oklch(from var(--mth-color-seed-warning) 0.96 calc(c * 0.24) h)",
          "dark": "oklch(from var(--mth-color-seed-warning) 0.24 calc(c * 0.40) h)"
        }
      }
    },
    "success": {
      "$value": "{color.seed.success}",
      "$extensions": {
        "com.methane.theme": {
          "light": "oklch(from var(--mth-color-seed-success) l c h)",
          "dark": "oklch(from var(--mth-color-seed-success) calc(l + 0.12) c h)"
        }
      }
    },
    "successSubtle": {
      "$value": "oklch(from var(--mth-color-seed-success) 0.95 calc(c * 0.24) h)",
      "$extensions": {
        "com.methane.theme": {
          "light": "oklch(from var(--mth-color-seed-success) 0.96 calc(c * 0.22) h)",
          "dark": "oklch(from var(--mth-color-seed-success) 0.22 calc(c * 0.42) h)"
        }
      }
    },
    "info": {
      "$value": "{color.seed.info}",
      "$extensions": {
        "com.methane.theme": {
          "light": "oklch(from var(--mth-color-seed-info) l c h)",
          "dark": "oklch(from var(--mth-color-seed-info) calc(l + 0.12) c h)"
        }
      }
    },
    "infoSubtle": {
      "$value": "oklch(from var(--mth-color-seed-info) 0.95 calc(c * 0.22) h)",
      "$extensions": {
        "com.methane.theme": {
          "light": "oklch(from var(--mth-color-seed-info) 0.96 calc(c * 0.20) h)",
          "dark": "oklch(from var(--mth-color-seed-info) 0.22 calc(c * 0.40) h)"
        }
      }
    },
    "backdrop": {
      "$value": "oklch(0.15 0.01 255 / 0.45)",
      "$extensions": {
        "com.methane.theme": {
          "light": "oklch(0.15 0.01 255 / 0.42)",
          "dark": "oklch(0.05 0.01 255 / 0.68)"
        }
      }
    }
  },
  "density": {
    "$type": "number",
    "$value": 1,
    "$description": "Global density multiplier (compact=0.8, default=1, comfortable=1.2)"
  },
  "space": {
    "$type": "dimension",
    "0": { "$value": "0px" },
    "px": { "$value": "1px" },
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.25rem" },
    "6": { "$value": "1.5rem" },
    "8": { "$value": "2rem" },
    "10": { "$value": "2.5rem" },
    "12": { "$value": "3rem" },
    "16": { "$value": "4rem" },
    "20": { "$value": "5rem" },
    "24": { "$value": "6rem" },
    "controlInline": {
      "$value": "calc(var(--mth-space-3) * var(--mth-density))",
      "$description": "Density-aware control inline padding"
    },
    "controlBlock": {
      "$value": "calc(var(--mth-space-2) * var(--mth-density))",
      "$description": "Density-aware control block padding"
    },
    "controlGap": {
      "$value": "calc(var(--mth-space-2) * var(--mth-density))",
      "$description": "Density-aware internal control gap"
    }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "Roboto",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "ui-monospace",
        "SFMono-Regular",
        "Menlo",
        "Monaco",
        "Consolas",
        "monospace"
      ]
    },
    "serif": {
      "$type": "fontFamily",
      "$value": ["Georgia", "Cambria", "Times New Roman", "Times", "serif"]
    }
  },
  "fontSize": {
    "$type": "dimension",
    "xs": { "$value": "0.75rem" },
    "sm": { "$value": "0.875rem" },
    "md": { "$value": "1rem" },
    "lg": { "$value": "1.125rem" },
    "xl": { "$value": "1.25rem" },
    "2xl": { "$value": "1.5rem" },
    "3xl": { "$value": "1.875rem" },
    "4xl": { "$value": "2.25rem" }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "normal": { "$value": 400 },
    "medium": { "$value": 500 },
    "semibold": { "$value": 600 },
    "bold": { "$value": 700 }
  },
  "lineHeight": {
    "$type": "number",
    "tight": { "$value": 1.25 },
    "normal": { "$value": 1.5 },
    "relaxed": { "$value": 1.75 }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "xs": { "$value": "0.125rem" },
    "sm": { "$value": "0.25rem" },
    "md": { "$value": "0.375rem" },
    "lg": { "$value": "0.5rem" },
    "xl": { "$value": "0.75rem" },
    "2xl": { "$value": "1rem" },
    "full": { "$value": "9999px" }
  },
  "shadow": {
    "$type": "shadow",
    "none": { "$value": "none" },
    "xs": {
      "$value": {
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px",
        "color": "oklch(0.15 0.01 255 / 0.06)"
      }
    },
    "sm": {
      "$value": {
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "3px",
        "spread": "0px",
        "color": "oklch(0.15 0.01 255 / 0.10)"
      }
    },
    "md": {
      "$value": {
        "offsetX": "0px",
        "offsetY": "4px",
        "blur": "8px",
        "spread": "-2px",
        "color": "oklch(0.15 0.01 255 / 0.12)"
      }
    },
    "lg": {
      "$value": {
        "offsetX": "0px",
        "offsetY": "12px",
        "blur": "24px",
        "spread": "-4px",
        "color": "oklch(0.15 0.01 255 / 0.16)"
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": "0ms" },
      "fast": { "$value": "120ms" },
      "normal": { "$value": "200ms" },
      "slow": { "$value": "320ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "emphasized": { "$value": [0.2, 0, 0, 1] },
      "decelerate": { "$value": [0, 0, 0, 1] },
      "accelerate": { "$value": [0.3, 0, 1, 1] }
    }
  },
  "zIndex": {
    "$type": "number",
    "base": { "$value": 0 },
    "dropdown": { "$value": 100 },
    "sticky": { "$value": 200 },
    "overlay": { "$value": 300 },
    "modal": { "$value": 400 },
    "popover": { "$value": 500 },
    "toast": { "$value": 600 },
    "tooltip": { "$value": 700 }
  }
}
