{
  "name": "@methane-ui/ssr",
  "version": "0.1.1",
  "description": "Streaming Declarative Shadow DOM (DSD) SSR engine for Methane UI wrapping @lit-labs/ssr with hybrid linked + critical inline style delivery (ADR-001, ADR-008)",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./dom-shim": {
      "types": "./dist/dom-shim.d.ts",
      "default": "./dist/dom-shim.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@lit-labs/ssr": "^4.1.0",
    "@lit-labs/ssr-client": "^1.1.8",
    "@lit-labs/ssr-dom-shim": "^1.6.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@methane-ui/test-conformance": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MehdiNosrati/methane.git"
  },
  "homepage": "https://mahdins.dev/methane/"
}
