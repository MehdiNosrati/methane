{
  "name": "@methane-ui/ui",
  "version": "0.1.1",
  "description": "Methane UI declarative-first accessible web components (ADR-001 through ADR-015)",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/components/*/index.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./*/element.js": {
      "types": "./dist/components/*/element.d.ts",
      "default": "./dist/components/*/element.js"
    },
    "./*/element": {
      "types": "./dist/components/*/element.d.ts",
      "default": "./dist/components/*/element.js"
    },
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "default": "./dist/components/*/index.js"
    }
  },
  "customElements": "custom-elements.json",
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src scripts",
    "test": "vitest run"
  },
  "dependencies": {
    "@lit/context": "^1.1.4",
    "@methane-ui/css": "workspace:^",
    "@methane-ui/primitives": "workspace:^",
    "@methane-ui/tokens": "workspace:^",
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@lit-labs/ssr": "^4.1.0",
    "@lit-labs/ssr-client": "^1.1.8",
    "@lit-labs/ssr-dom-shim": "^1.6.0",
    "@methane-ui/core": "workspace:^",
    "@methane-ui/spec-compiler": "workspace:^",
    "@methane-ui/test-conformance": "workspace:^",
    "@methane-ui/wrapper-codegen": "workspace:^"
  },
  "peerDependencies": {
    "@methane-ui/core": "^0.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MehdiNosrati/methane.git"
  },
  "homepage": "https://mahdins.dev/methane/"
}
