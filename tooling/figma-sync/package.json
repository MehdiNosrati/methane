{
  "name": "@methane-ui/figma-sync",
  "version": "0.1.0",
  "description": "Two-way Figma Variables REST API <-> W3C DTCG token sync and multi-framework @figma/code-connect generator",
  "license": "MIT",
  "type": "module",
  "bin": {
    "methane-figma-sync": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@methane-ui/spec-compiler": "workspace:^",
    "@methane-ui/tokens": "workspace:^",
    "@methane-ui/wrapper-codegen": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MehdiNosrati/methane.git"
  },
  "homepage": "https://mahdins.dev/methane/"
}
